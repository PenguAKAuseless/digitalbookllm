# Used by the root docker-compose.yml only, to override the Postgres
# container's credentials and the browser-facing API URL. The backend's own
# settings (LLM provider keys, chunking params, etc.) live in backend/.env —
# copy backend/.env.example there too before running `docker compose up`.

DB_USER=postgres
DB_PASSWORD=password
DB_NAME=digitalbookllm
DB_PORT=5432
PORT=3001
NODE_ENV=production

# Must be reachable from the browser, not the Docker-internal "backend" hostname.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
