{
    "name": "digitalbookllm-backend",
    "version": "2.0.0",
    "description": "Backend API for DigitalBookLLM with RAG, OCR, knowledge-graph extraction, and streaming AI chat",
    "main": "dist/index.js",
    "scripts": {
        "dev": "nodemon --exec ts-node src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "migrate": "ts-node src/db/migrate.ts",
        "test": "jest --runInBand",
        "test:security": "ts-node eval/security-probes.ts",
        "test:load": "ts-node eval/load-test.ts",
        "eval:rag": "ts-node eval/rag-eval.ts"
    },
    "keywords": [
        "rag",
        "llm",
        "education",
        "knowledge-graph"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "@napi-rs/canvas": "^0.1.53",
        "@supabase/supabase-js": "^2.45.4",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@xenova/transformers": "^2.10.0",
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.5",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.3",
        "jszip": "^3.10.1",
        "mammoth": "^1.6.0",
        "morgan": "^1.10.0",
        "multer": "^2.0.0-rc.4",
        "pdf-parse": "^1.1.1",
        "pdfjs-dist": "^4.6.82",
        "pg": "^8.11.3",
        "tesseract.js": "^5.1.1",
        "uuid": "^9.0.1"
    },
    "devDependencies": {
        "@types/autocannon": "^7.12.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.12",
        "@types/morgan": "^1.9.9",
        "@types/multer": "^1.4.11",
        "@types/node": "^20.10.5",
        "@types/pdf-parse": "^1.1.5",
        "@types/pg": "^8.10.9",
        "@types/supertest": "^6.0.2",
        "@types/uuid": "^9.0.7",
        "autocannon": "^7.15.0",
        "jest": "^29.7.0",
        "nodemon": "^3.0.2",
        "supertest": "^7.0.0",
        "ts-jest": "^29.1.2",
        "ts-node": "^10.9.2",
        "typescript": "^5.3.3"
    }
