# Development image with hot reload. Debian-based to match Dockerfile
# (native canvas/OCR dependencies need glibc + fontconfig).
FROM node:20-bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl fontconfig fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package*.json tsconfig.json ./
RUN npm install

RUN mkdir -p ./uploads

EXPOSE 3001

CMD ["npm", "run", "dev"]
