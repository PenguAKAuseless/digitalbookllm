# ============================================
# DigitalBookLLM Backend - Docker Environment
# ============================================
#
# Copy this file to .env and configure
# DO NOT commit .env to git
#

# ============================================
# REQUIRED SETTINGS
# ============================================

# Together AI API Key - Get from: https://api.together.xyz/
# This is required for real AI responses
# Leave empty to use mock responses for testing
TOGETHER_API_KEY=

# ============================================
# DATABASE (PostgreSQL)
# ============================================

# Database credentials
# Change DB_PASSWORD for production!
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=digitalbookllm

# Database port (on host machine)
# Change if 5433 is already in use
DB_PORT=5433

# Database connection URL
# Update if you changed credentials above
DATABASE_URL=postgresql://postgres:password@localhost:5433/digitalbookllm

# ============================================
# SERVER CONFIGURATION
# ============================================

# Backend API port (on host machine)
# Change if 3001 is already in use
PORT=3001

# Environment mode
# Use 'development' for dev, 'production' for prod
NODE_ENV=production

# Frontend URL for CORS
# Update when you deploy frontend
FRONTEND_URL=http://localhost:3000

# ============================================
# LLM API CONFIGURATION
# ============================================

# Together AI endpoint
TOGETHER_API_URL=https://api.together.xyz/v1/chat/completions

# LLM model to use
# Recommended: meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# ============================================
# RATE LIMITING
# ============================================

# Maximum queries per user per day
MAX_QUERIES_PER_DAY=50

# ============================================
# FILE UPLOAD
# ============================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=100

# Upload directory (inside container)
# Don't change this when using Docker
UPLOAD_DIR=/app/uploads

# ============================================
# EMBEDDINGS
# ============================================

# Embedding model from HuggingFace
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Vector dimension for embeddings
EMBEDDING_DIMENSION=384

# Text chunking settings
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ============================================
# DOCKER-SPECIFIC NOTES
# ============================================
#
# 1. Database Host:
#    - When using Docker Compose, the backend automatically
#      connects to 'postgres' container (not 'localhost')
#    - This is handled automatically, no need to change
#
# 2. Ports:
#    - PORT: Backend API port on your machine
#    - DB_PORT: PostgreSQL port on your machine
#    - Internal container ports are fixed (3001, 5432)
#
# 3. Volumes:
#    - Database data stored in: backend_postgres_data
#    - Uploads stored in: backend_uploads_data
#    - Use 'docker volume ls' to see them
#
# 4. To start:
#    - Production: docker-compose up -d
#    - Development: docker-compose -f docker-compose.dev.yml up
#
# ============================================
