# Database (Supabase Postgres with pgvector — see docs/architecture-decisions.md ADR-03/ADR-11)
DATABASE_URL=postgresql://postgres:password@localhost:5432/digitalbookllm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=digitalbookllm

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
WORKER_CONCURRENCY=2

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Object storage (ADR-05). Leave both unset to use local disk storage in development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── LLM providers (ADR-07) ───────────────────────────────────────────────
# Router priority: operator-configured providers below (in this order) ->
# Gemini free tier -> Groq. Each candidate is health-checked before use, with
# automatic failover to the next one.

# Tier 1 — operator providers (free-trial friendly, enable any subset):
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tier 2 — Google Gemini free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tier 3 — Groq (final fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional custom TTS endpoint. When unset, the client uses browser speech
# synthesis as a free fallback.
TTS_PROVIDER_URL=

# Rate Limiting
MAX_QUERIES_PER_DAY=100

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Embeddings & chunking (FR04, FR05)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200
SEMANTIC_CHUNK_THRESHOLD=0.45
