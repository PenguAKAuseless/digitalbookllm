# Database (Supabase Postgres with pgvector — see docs/architecture-decisions.md ADR-03/ADR-11)
DATABASE_URL=postgresql://postgres:password@localhost:5432/digitalbookllm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=digitalbookllm

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
WORKER_CONCURRENCY=1

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Object storage (ADR-05). Leave both unset to use local disk storage in development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=documents

# ── LLM providers (ADR-07) ───────────────────────────────────────────────
# Router priority: operator-configured providers below (in this order) ->
# Gemini free tier -> Groq. Each candidate is health-checked before use, with
# automatic failover to the next one.

# Tier 1 — operator providers (free-trial friendly, enable any subset):
# HeFU (paid, pay-as-you-go OpenAI-compatible gateway, https://hefu.hk) — tried first when set.
HEFU_API_KEY=
HEFU_MODEL=deepseek-v4-flash
# Knowledge-graph extraction (JSON) model: a non-reasoning model; reasoning models time out on long windows.
HEFU_GRAPH_MODEL=deepseek-v3

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama-3.3-70b

SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Tier 2 — Google Gemini free tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Tier 3 — Groq (final fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# A model rejected with 404 is dropped (the key's /models list is checked); one throttled with 429
# is rested while the next model is used, since Groq meters every model separately.

# Optional self-hosted model (Ollama), tried before every hosted provider when set. Local use only.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Knowledge-graph extraction budget per LLM request and per document. The graph is used by
# retrieval, so it should cover the whole book: 20 x 6000 chars covers ~120K characters in full
# (~100K tokens); longer books are sampled evenly. Each request fits Groq's free tier
# (8K tokens/minute per model, prompt + max_tokens).
GRAPH_WINDOW_CHARS=6000
GRAPH_OUTPUT_TOKENS=2500
GRAPH_MAX_CALLS=20
GRAPH_CHAT_DEBOUNCE_SECONDS=120

# Optional custom TTS endpoint. When unset, the client uses browser speech
# synthesis as a free fallback.
TTS_PROVIDER_URL=

# Rate Limiting
MAX_QUERIES_PER_DAY=100

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Embeddings & chunking (FR04, FR05)
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE_CHARS=1800
CHUNK_OVERLAP_CHARS=200
SEMANTIC_CHUNK_THRESHOLD=0.45
# Semantic pieces shorter than this are merged into a neighbour (chosen on the dev splits, see eval/experiments).
CHUNK_MIN_CHARS=900

# Reverse-proxy hops in front of the API (Render/HF Spaces = 1). Set 0 when
# exposed directly, otherwise clients can spoof X-Forwarded-For.
TRUST_PROXY=1
# Per-IP request budget per 15 minutes across /api
API_RATE_LIMIT_PER_15MIN=1000
