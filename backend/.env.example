# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/digitalbookllm
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=digitalbookllm

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# LLM Providers — tried in this priority order:
# 1. Together AI
TOGETHER_API_KEY=
TOGETHER_API_URL=https://api.together.xyz/v1/chat/completions
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free

# 2. OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 3. Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# 4. Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# 5. Ollama (local — set OLLAMA_URL to enable, e.g. http://localhost:11434)
OLLAMA_URL=
OLLAMA_MODEL=llama3.2

# 6. Xenova local model (always available, no config needed)
XENOVA_GENERATION_MODEL=Xenova/flan-t5-base

# Rate Limiting
MAX_QUERIES_PER_DAY=100

# File Upload
MAX_FILE_SIZE_MB=100
UPLOAD_DIR=./uploads

# Embeddings
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
