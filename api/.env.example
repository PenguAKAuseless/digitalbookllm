# DigitalBookLLM Python API Configuration

# Application
DEBUG=false
API_PREFIX=/api/v2

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database (same as Express backend)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=digitalbookllm

# Qdrant Vector Database
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=digitalbookllm_chunks

# JWT Auth (must match Express backend for compatibility)
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# LLM Providers (in priority order - first available is used)
TOGETHER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OLLAMA_URL=

# Model Configuration
BASE_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LoRA Configuration
LORA_ADAPTERS_PATH=./lora_adapters
DEFAULT_LORA_ADAPTER=general

# Agentic RAG Configuration
MAX_RAG_ITERATIONS=5
MAX_SUB_QUERIES=3
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.2

# Rate Limiting
MAX_QUERIES_PER_DAY=100

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
